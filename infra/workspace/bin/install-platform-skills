#!/usr/bin/env bash
set -euo pipefail

platform_root="${PLATFORM_ROOT:-/workspace/platform}"
source_dir="${platform_root}/skills"
codex_home="${CODEX_HOME:-${HOME}/.codex}"
dest_dir="${codex_home}/skills"

if [ ! -d "${source_dir}" ]; then
  echo "ERROR: skills source directory not found: ${source_dir}" >&2
  exit 1
fi

mkdir -p "${dest_dir}"

installed=0
for skill_dir in "${source_dir}"/requirements-workflow-*; do
  [ -d "${skill_dir}" ] || continue
  skill_name="$(basename "${skill_dir}")"
  target="${dest_dir}/${skill_name}"

  rm -rf "${target}"
  cp -a "${skill_dir}" "${target}"
  installed=$((installed + 1))
done

if [ "${installed}" -eq 0 ]; then
  echo "ERROR: no requirements workflow skill directories found in ${source_dir}" >&2
  exit 1
fi

echo "Installed ${installed} requirements workflow skill directories into ${dest_dir}"
