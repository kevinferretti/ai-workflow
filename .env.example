# Local deployment settings for the single-user AI workflow host workspace.
# Copy to .env on the cloud VM and edit values there. Do not commit .env.

WORKSPACE_USER=codex

# Keep these pinned for reproducible host provisioning. Update deliberately.
CODEX_NPM_VERSION=0.132.0
GLAB_VERSION=1.99.0
NODE_MAJOR=22
PLAYWRIGHT_NPM_VERSION=1.60.0

TZ=America/Chicago

# Persistent host paths. Keep these under WORKSPACE_ROOT so repos, runtime
# state, and backups stay portable without nesting project repos inside the
# platform checkout.
WORKSPACE_ROOT=~/workspace
WORKSPACE_REPOS_DIR=${WORKSPACE_ROOT}/repos
WORKSPACE_CODEX_STATE_DIR=${WORKSPACE_ROOT}/state/codex
WORKSPACE_GH_STATE_DIR=${WORKSPACE_ROOT}/state/gh
WORKSPACE_GLAB_STATE_DIR=${WORKSPACE_ROOT}/state/glab
WORKSPACE_SSH_STATE_DIR=${WORKSPACE_ROOT}/state/ssh
WORKSPACE_COMMAND_HISTORY_DIR=${WORKSPACE_ROOT}/state/commandhistory

# Git hosting auth. Prefer token files over inline tokens so .env can stay
# non-secret; the setup script also accepts GH_TOKEN/GITHUB_TOKEN and
# GITLAB_TOKEN/GITLAB_ACCESS_TOKEN from the environment.
WORKSPACE_AUTO_GIT_AUTH=1
WORKSPACE_REQUIRE_GIT_AUTH=0
GITHUB_HOST=github.com
GITHUB_GIT_PROTOCOL=ssh
GITHUB_TOKEN_FILE=
GITLAB_HOST=labs.gauntletai.com
GITLAB_API_PROTOCOL=https
GITLAB_GIT_PROTOCOL=ssh
GITLAB_TOKEN_FILE=
WORKSPACE_GIT_UPLOAD_SSH_KEY=1
WORKSPACE_GIT_SSH_KEY_FILE=${WORKSPACE_SSH_STATE_DIR}/id_ed25519_ai_workflow
