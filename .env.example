# Local deployment settings for the single-user AI workflow host workspace.
# Copy to .env on the cloud VM and edit values there. Do not commit .env.

WORKSPACE_USER=codex

# Keep these pinned for reproducible host provisioning. Update deliberately.
CODEX_NPM_VERSION=0.132.0
GLAB_VERSION=1.99.0
NODE_MAJOR=22

TZ=America/Chicago

# Persistent host paths relative to this repo. These are intentionally gitignored.
WORKSPACE_REPOS_DIR=./workspace/repos
WORKSPACE_CODEX_STATE_DIR=./.state/codex
WORKSPACE_GH_STATE_DIR=./.state/gh
WORKSPACE_GLAB_STATE_DIR=./.state/glab
WORKSPACE_SSH_STATE_DIR=./.state/ssh
WORKSPACE_COMMAND_HISTORY_DIR=./.state/commandhistory
