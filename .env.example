# Local deployment settings for the single-user AI workflow workspace.
# Copy to .env on the cloud VM and edit values there. Do not commit .env.

COMPOSE_PROJECT_NAME=ai-workflow

WORKSPACE_IMAGE=ai-workflow/workspace:local
WORKSPACE_CONTAINER_NAME=ai-workspace
WORKSPACE_HOSTNAME=ai-workspace

# Keep this pinned for reproducible builds. Update deliberately.
CODEX_NPM_VERSION=0.132.0
GLAB_VERSION=1.99.0
NODE_MAJOR=22

# Match the primary Linux VM user where practical so bind-mounted files stay editable.
WORKSPACE_UID=1000
WORKSPACE_GID=1000

TZ=America/Chicago

# Persistent host paths. These are intentionally gitignored.
WORKSPACE_REPOS_DIR=./workspace/repos
WORKSPACE_CODEX_STATE_DIR=./.state/codex
WORKSPACE_GH_STATE_DIR=./.state/gh
WORKSPACE_GLAB_STATE_DIR=./.state/glab
WORKSPACE_SSH_STATE_DIR=./.state/ssh
WORKSPACE_COMMAND_HISTORY_DIR=./.state/commandhistory
